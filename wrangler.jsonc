{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-climate-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GOVEE_TEMPERATURE_UNIT": "fahrenheit"
  },
  "secrets": {
    "required": ["GOVEE_API_KEY"]
  }
}
