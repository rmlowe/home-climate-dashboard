{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-climate-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp"]
  },
  // Production readings table was created via D1 Console; see README.
  "d1_databases": [{
    "binding": "DB",
    "database_name": "home-climate-history",
    "database_id": "27a4c38a-b436-48a1-9bf7-3f18abb980ca",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false
    }
  },
  "vars": {
    // Non-secret Access identifiers; keep in sync with the protecting application.
    "MCP_AUTH_MODE": "access",
    "MCP_ACCESS_TEAM_DOMAIN": "https://frosty-poetry-2e73.cloudflareaccess.com",
    "MCP_ACCESS_AUD": "476e1a1062e389e1211d7d20cc2cce4f49acb2150ae648a618e1532d95e4b65b",
    "GOVEE_TEMPERATURE_UNIT": "fahrenheit",
    "WEATHER_LATITUDE": "51.61",
    "WEATHER_LONGITUDE": "-0.21",
    "WEATHER_LOCATION_NAME": "Mill Hill East"
  },
  "secrets": {
    "required": ["GOVEE_API_KEY"]
  }
}
