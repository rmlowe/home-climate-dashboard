{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-climate-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Apply migrations before enabling the schedule below (see README).
  "d1_databases": [{
    "binding": "DB",
    "database_name": "home-climate-history",
    "database_id": "27a4c38a-b436-48a1-9bf7-3f18abb980ca",
    "migrations_dir": "migrations"
  }],
  // "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "GOVEE_TEMPERATURE_UNIT": "fahrenheit"
  },
  "secrets": {
    "required": ["GOVEE_API_KEY"]
  }
}
