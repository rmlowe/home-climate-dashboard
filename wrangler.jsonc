{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-climate-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Enable both sections after creating D1 and applying migrations (see README).
  // "d1_databases": [{
  //   "binding": "DB",
  //   "database_name": "home-climate-history",
  //   "database_id": "REPLACE_WITH_CREATED_DATABASE_ID",
  //   "migrations_dir": "migrations"
  // }],
  // "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "GOVEE_TEMPERATURE_UNIT": "fahrenheit"
  },
  "secrets": {
    "required": ["GOVEE_API_KEY"]
  }
}
